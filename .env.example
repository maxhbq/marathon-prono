# Configuration publique de l'application Web : console Firebase > Paramètres du projet > Vos applications.
# Ce fichier ne contient AUCUNE clé privée, aucun mot de passe et aucun jeton de déploiement.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=marathon-prono.firebaseapp.com
FIREBASE_PROJECT_ID=marathon-prono
FIREBASE_APP_ID=
# Facultatif : fourni dans la configuration Web Firebase.
FIREBASE_MESSAGING_SENDER_ID=

# Laisser false pour le vrai projet. true uniquement pour des données de test locales.
FIREBASE_USE_EMULATORS=false

# Identifiant du site Hosting. Vide = site par défaut, identique au projectId.
FIREBASE_HOSTING_SITE=
